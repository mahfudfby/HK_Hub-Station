# Opsional: override config Firebase (default sudah di src/shared/lib/firebase.ts)
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# Opsional: ID koleksi data (default: spbu-app)
VITE_APP_ID=spbu-app
# Opsional: Gemini API key (fitur alamat otomatis)
VITE_GEMINI_API_KEY=

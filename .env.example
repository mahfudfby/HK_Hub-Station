# Opsional: override config Firebase (default sudah di src/shared/lib/firebase.ts)
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# Opsional: ID koleksi data (default: spbu-app)
VITE_APP_ID=spbu-app
# Opsional: Gemini API key (fitur alamat otomatis)
VITE_GEMINI_API_KEY=

# ---- Cloudinary (penyimpanan gambar UTAMA: logo & tanda tangan Slip Gaji) ----
# Cloud name + API key bersifat publik (aman di frontend). Default sudah di src/shared/lib/cloudinary.ts
VITE_CLOUDINARY_CLOUD_NAME=dl4pyan8v
VITE_CLOUDINARY_API_KEY=654582583389542
# Opsional (alternatif tanpa server): nama Unsigned Upload Preset dari dashboard Cloudinary
VITE_CLOUDINARY_UPLOAD_PRESET=
# RAHASIA - HANYA di Vercel (Environment Variables, JANGAN pakai prefix VITE_), dipakai api/cloudinary-sign.ts
# CLOUDINARY_API_SECRET=
